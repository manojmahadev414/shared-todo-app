# MySQL connection string; use a least-privilege app user, TLS, and a pooled
# connection endpoint suitable for Vercel Functions.
DATABASE_URL="mysql://app_user:replace-me@db.example.net:3306/shared_todo"

# Absolute URL of the deployment (use http://localhost:3000 locally).
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth credentials; keep these in Vercel Environment Variables too.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
