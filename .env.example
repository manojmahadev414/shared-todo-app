# PostgreSQL connection string. Locally this is the Docker container from the
# README; on Vercel it is injected by the Prisma Postgres storage integration.
DATABASE_URL="postgresql://shared_todo:replace-me@127.0.0.1:5433/shared_todo"

# Absolute URL of the deployment (use http://localhost:3000 locally).
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
APP_TIME_ZONE="Asia/Kolkata"

# Google OAuth credentials; keep these in Vercel Environment Variables too.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP settings for account verification, email changes, and password recovery.
# During local development only, leaving these blank prints links in the dev server terminal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="TheDoList <no-reply@example.com>"
